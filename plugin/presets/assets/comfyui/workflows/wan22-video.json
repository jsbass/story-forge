{
  "id": "wan22-video",
  "version": 1,
  "capability": "video",
  "kinds": ["video"],
  "status": "tested",
  "description": "Wan 2.2 TI2V 5B short clips (text- or image-to-video). On 8 GB VRAM keep to 480p and about 2-3 s (a 2 s clip took ~90 s on an RTX 3070). Output is WebM (VP9).",
  "params": {
    "unet": { "node": "1", "input": "unet_name", "model_folder": "diffusion_models", "default": "wan2.2_ti2v_5B_fp16.safetensors" },
    "text_encoder": { "node": "2", "input": "clip_name", "model_folder": "text_encoders", "default": "umt5_xxl_fp8_e4m3fn_scaled.safetensors" },
    "vae": { "node": "3", "input": "vae_name", "model_folder": "vae", "default": "wan2.2_vae.safetensors" },
    "prompt": { "node": "5", "input": "text", "default": "" },
    "negative": { "node": "6", "input": "text", "default": "blurry, static, low quality, jpeg artifacts, deformed, watermark, text" },
    "width": { "node": "7", "input": "width", "default": 832 },
    "height": { "node": "7", "input": "height", "default": 480 },
    "frames": { "node": "7", "input": "length", "default": 49 },
    "seed": { "node": "8", "input": "seed", "default": 0 },
    "steps": { "node": "8", "input": "steps", "default": 20 },
    "cfg": { "node": "8", "input": "cfg", "default": 5 },
    "fps": { "node": "10", "input": "fps", "default": 24 },
    "filename_prefix": { "node": "10", "input": "filename_prefix", "default": "forge/video" }
  },
  "outputs": { "type": "video", "ext": "webm" },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "fp8_e4m3fn" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "wan2.2_vae.safetensors" } },
    "4": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": 8 } },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["2", 0] } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["2", 0] } },
    "7": { "class_type": "Wan22ImageToVideoLatent", "inputs": { "vae": ["3", 0], "width": 832, "height": 480, "length": 49, "batch_size": 1 } },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0], "seed": 0, "steps": 20, "cfg": 5, "sampler_name": "uni_pc", "scheduler": "simple",
        "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0], "denoise": 1
      }
    },
    "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] } },
    "10": { "class_type": "SaveWEBM", "inputs": { "images": ["9", 0], "filename_prefix": "forge/video", "codec": "vp9", "fps": 24, "crf": 32 } }
  }
}
