{
  "id": "sdxl-draft",
  "version": 1,
  "capability": "image",
  "kinds": ["bg", "portrait", "ui"],
  "status": "tested",
  "description": "SDXL-Turbo quick drafts (about 1-2 s each) for art-direction samples and composition checks. Not for final assets.",
  "params": {
    "checkpoint": { "node": "1", "input": "ckpt_name", "model_folder": "checkpoints", "default": "sd_xl_turbo_1.0_fp16.safetensors" },
    "prompt": { "node": "2", "input": "text", "default": "" },
    "negative": { "node": "3", "input": "text", "default": "lowres, blurry, watermark, text" },
    "width": { "node": "4", "input": "width", "default": 768 },
    "height": { "node": "4", "input": "height", "default": 512 },
    "seed": { "node": "5", "input": "seed", "default": 0 },
    "steps": { "node": "5", "input": "steps", "default": 4 },
    "filename_prefix": { "node": "7", "input": "filename_prefix", "default": "forge/draft" }
  },
  "outputs": { "type": "image", "ext": "png" },
  "graph": {
    "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors" } },
    "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
    "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
    "4": { "class_type": "EmptyLatentImage", "inputs": { "width": 768, "height": 512, "batch_size": 1 } },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0], "seed": 0, "steps": 4, "cfg": 1, "sampler_name": "euler_ancestral", "scheduler": "sgm_uniform",
        "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0], "denoise": 1
      }
    },
    "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
    "7": { "class_type": "SaveImage", "inputs": { "images": ["6", 0], "filename_prefix": "forge/draft" } }
  }
}
